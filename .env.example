# Funded Base mainnet private key holding USDC — pays the x402 API calls.
# NEVER commit or log this value.
BUYER_PRIVATE_KEY=

# Telegram bot credentials (create a bot via @BotFather, get chat id via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily summary calls gas "ucuz" when baseFeePerGas is below this many gwei.
GAS_THRESHOLD_GWEI=0.01

# Optional overrides.
# CRON_LEADERBOARD=0 9 * * *
# CRON_GAS=0 * * * *             # paid gas check, log-only (traffic/attribution)
# CRON_GAS_SUMMARY=0 9 * * *     # daily Telegram gas summary
# BUILDER_CODE=bc_lhfd8zad
